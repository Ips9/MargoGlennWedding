{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "margo-glenn-wedding",
  "main": "./worker/preview-wrapper.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "routes": [
    { "pattern": "margoenglenn.com", "custom_domain": true },
    { "pattern": "www.margoenglenn.com", "custom_domain": true }
  ],

  "vars": {
    "PUBLIC_SITE_HOST": "margoenglenn.com",
    "CF_ACCESS_TEAM_DOMAIN": "https://quiet-rice-9922.cloudflareaccess.com",
    "CF_ACCESS_AUD": "111566afadc531b7accb095c25a863b4c1d19492323ddd1a71db8e93847fd8bc"
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "margo_glenn_wedding_db",
      "database_name": "margo-glenn-wedding-db",
      "database_id": "82b35a74-ad2c-4229-b6c8-9c79a783ea62",
      "remote": true
    }
  ],

  "r2_buckets": [
    {
      "binding": "WEDDING_PHOTOS",
      "bucket_name": "margo-glenn-wedding-photos"
    }
  ]
}
